{
  "schemaVersion": 1,
  "scope": "stage23 coach-relations draft fixture",
  "status": "accepted-gate-p",
  "externalDependencies": {
    "trainingProposals": {
      "resolverBase": "src/test/resources/",
      "relativePath": "training-proposals-contract.json",
      "sha256": "65254ebf9aaa4062ebf8ef71df99c76876685ce10ec0bd2fa8645fced56ea998",
      "refs": [
        "#/dtoJsonSchema/$defs/ApprovalDraft",
        "#/dtoJsonSchema/$defs/Proposal",
        "#/dtoJsonSchema/$defs/DecisionResponse"
      ]
    }
  },
  "token": {
    "bytes": 32,
    "encoding": "base64url-without-padding",
    "canonicalLength": 43,
    "ttlSeconds": 604800,
    "transport": "InvitationAcceptRequest.token JSON body only; never URL, log, raw ledger or post-create response",
    "storage": {
      "algorithm": "HMAC-SHA-256",
      "keyPurpose": "invite-token",
      "keyVersion": 1,
      "columns": [
        "keyVersion",
        "digest"
      ],
      "retainKeySeconds": 691200,
      "tombstoneRetention": "retain digest/invite tombstone while coach account exists"
    },
    "timeVectors": [
      {
        "nowMillis": 1700604800000,
        "expiresAtMillis": 1700604800000,
        "error": "invite_expired"
      },
      {
        "nowMillis": 1700604800001,
        "expiresAtMillis": 1700604800000,
        "error": "invite_expired"
      },
      {
        "retiredKey": true,
        "error": "invite_not_found"
      },
      {
        "sameConsumerAfterRevoke": true,
        "error": "relation_not_found"
      }
    ],
    "vectors": [
      {
        "token": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
        "valid": true
      },
      {
        "token": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=",
        "valid": false,
        "error": "invalid_request"
      },
      {
        "token": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
        "valid": false,
        "error": "invalid_request"
      }
    ]
  },
  "rawMutation": {
    "maxBytes": 524288,
    "rejectBeforeDto": [
      "empty",
      "non_utf8",
      "bom",
      "duplicate_member",
      "trailing_data"
    ],
    "ledgerKey": [
      "actorId",
      "operationId"
    ],
    "storedBinding": [
      "action",
      "normalizedRoute",
      "resourceTuple",
      "rawSha256"
    ],
    "normal": "rawSha256 plus exact raw bytes and immutable result; changed action/route/resource/body is relation_operation_conflict",
    "acceptSecretException": "rawSha256 plus sanitized inviteId/relationId/grants/status only; no raw bytes/token",
    "createSecretException": "sanitized invitation metadata only; exact replay is invite_token_not_replayable"
  },
  "pagination": {
    "limit": [
      1,
      50
    ],
    "responseBytes": 1048576,
    "ttlSeconds": 900,
    "hmacPurpose": "coach-relations/cursor/v1",
    "payload": [
      "v",
      "keyVersion",
      "kind",
      "actorId",
      "relationId",
      "recipientId",
      "directoryRevision",
      "recipientSyncRevision",
      "lastRelationId",
      "lastRecordId",
      "expiresAtMillis"
    ],
    "errors": {
      "bad": "invalid_cursor",
      "expired": "cursor_expired",
      "retiredKey": "cursor_key_retired",
      "changedSnapshot": "relation_snapshot_changed"
    },
    "grammar": "base64url(UTF8(canonicalQuery)).base64url(HMAC-SHA-256(derived(cursor),UTF8(canonicalQuery))); canonicalQuery has wireKeys in declared order, ASCII lowercase UUIDs, empty optional values and no percent encoding; wireAliases maps semantic payload names to wire keys",
    "vectors": [
      {
        "kind": "directory-clients",
        "changedDirectoryRevision": true,
        "error": "relation_snapshot_changed"
      },
      {
        "kind": "completed-workouts",
        "expired": true,
        "error": "cursor_expired"
      }
    ],
    "wireKeys": [
      "v",
      "k",
      "kind",
      "actor",
      "relation",
      "recipient",
      "directoryRevision",
      "recipientSyncRevision",
      "lastRelationId",
      "lastRecordId",
      "expiresAtMillis"
    ],
    "wireAliases": {
      "keyVersion": "k",
      "actorId": "actor",
      "relationId": "relation",
      "recipientId": "recipient"
    }
  },
  "crypto": {
    "existingCryptoCompatibility": "Crypto currently has one unversioned gym.token-pepper byte key. keyVersion is configuration metadata, not a second secret.",
    "derive": "HMAC-SHA-256(UTF8(gym.token-pepper), ASCII('yarumo/coach-relations/' + purpose + '/key/v' + keyVersion)); digest/signature uses that 32-byte result as HMAC key",
    "purposes": [
      "invite-token",
      "cursor"
    ],
    "rotation": "Configuration selects current and retained pepper material by integer version. Issue only with current. After last issuance with a version, retain its verification key for 691200 seconds (invite TTL plus one day); cursor TTL is shorter. Retire the key after that interval independently of retained database invite tombstones: retired-key invite lookup returns invite_not_found; retired-key cursor returns cursor_key_retired. Tombstones remain while coach account exists.",
    "testKey": "test-pepper-with-at-least-thirty-two-bytes",
    "vectors": [
      {
        "purpose": "invite-token",
        "keyVersion": 1,
        "derivedKeyHmacHex": "c82a01511cc72939fad9351899b82f2f540775a0a12360a4ff7e5e906ae05d25",
        "message": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
        "hmacHex": "7604b3eeefee5ca53627d762ed521dd26f4b349b7926c120a1225f17c7e2a77a"
      },
      {
        "purpose": "cursor",
        "keyVersion": 1,
        "derivedKeyHmacHex": "c002c6cb49ec879362a5f0e1657a504b4cd4125752e2c6df0d6854b271c9bdd7",
        "canonicalQuery": "v=1&k=1&kind=completed-workouts&actor=11111111-1111-4111-8111-111111111111&relation=22222222-2222-4222-8222-222222222222&recipient=33333333-3333-4333-8333-333333333333&directoryRevision=&recipientSyncRevision=9&lastRelationId=&lastRecordId=44444444-4444-4444-8444-444444444444&expiresAtMillis=2000000000000",
        "hmacHex": "e8c178e4c3588881e1992f8420fb09bb620848f27a8ed059c2e9d50acc351472"
      }
    ]
  },
  "persistence": {
    "coachRelations": "id UUID PK; coach_historical_id UUID NOT NULL; recipient_historical_id UUID NOT NULL; coach_live_id UUID NULL FK users(id) ON DELETE RESTRICT; recipient_live_id UUID NULL FK users(id) ON DELETE RESTRICT; state ACTIVE|REVOKED; calendar/completed_workouts NOT NULL; UNIQUE active live pair; rows referenced by COACH proposal/version are retained REVOKED tombstones",
    "coachInvites": "id UUID PK; coach_historical_id NOT NULL; coach_live_id NULL FK users(id) ON DELETE RESTRICT; token_key_version NOT NULL; token_digest NOT NULL; expires_at NOT NULL; consumed_relation_id NULL FK coach_relations(id) ON DELETE RESTRICT; tombstone/digest retained while coach account exists",
    "proposalOrigin": "training_proposals.origin_relation_id NULL FK coach_relations(id) ON DELETE RESTRICT; training_proposal_versions.origin_relation_id NULL FK coach_relations(id) ON DELETE RESTRICT; CHECK source!='COACH' OR origin_relation_id IS NOT NULL for new rows; trigger/constraint requires version origin equals proposal origin; legacy null permitted only for migration and authority always denies it",
    "operationLedger": "UNIQUE(actor_id,operation_id); action NOT NULL; normalized_route NOT NULL; resource_tuple NOT NULL; raw_sha256 NOT NULL; accept/create sanitized result metadata has no token/raw body"
  },
  "routeBindings": {
    "createInvite": {
      "action": "CREATE_INVITE",
      "normalizedRoute": "POST /v1/coach-relations/invitations",
      "resourceTuple": "actorId"
    },
    "acceptInvite": {
      "action": "ACCEPT_INVITE",
      "normalizedRoute": "POST /v1/coach-relations/invitations/accept",
      "resourceTuple": "inviteId"
    },
    "revokeRelation": {
      "action": "REVOKE_RELATION",
      "normalizedRoute": "POST /v1/coach-relations/{relationId}/revoke",
      "resourceTuple": "relationId"
    },
    "createProposal": {
      "action": "CREATE_COACH_PROPOSAL",
      "normalizedRoute": "POST /v1/coach-relations/{relationId}/training-proposals",
      "resourceTuple": "relationId"
    },
    "reviseProposal": {
      "action": "REVISE_COACH_PROPOSAL",
      "normalizedRoute": "PUT /v1/coach-relations/{relationId}/training-proposals/{proposalId}",
      "resourceTuple": "relationId,proposalId"
    },
    "revokeProposal": {
      "action": "REVOKE_COACH_PROPOSAL",
      "normalizedRoute": "POST /v1/coach-relations/{relationId}/training-proposals/{proposalId}/revoke",
      "resourceTuple": "relationId,proposalId"
    }
  },
  "routes": [
    {
      "method": "POST",
      "path": "/v1/coach-relations/invitations",
      "request": "InvitationCreateRequest",
      "success": 201,
      "response": "InvitationCreated",
      "errors": [
        "unauthorized",
        "relation_exists",
        "relation_operation_conflict",
        "invite_token_not_replayable"
      ]
    },
    {
      "method": "POST",
      "path": "/v1/coach-relations/invitations/accept",
      "request": "InvitationAcceptRequest",
      "success": 200,
      "response": "Relation",
      "errors": [
        "unauthorized",
        "forbidden",
        "invite_not_found",
        "invite_expired",
        "invite_used",
        "invite_consent_conflict",
        "relation_operation_conflict"
      ]
    },
    {
      "method": "GET",
      "path": "/v1/coach-relations/{clients|coaches}?limit&cursor",
      "success": 200,
      "response": "DirectoryPage",
      "errors": [
        "unauthorized",
        "invalid_cursor",
        "cursor_expired",
        "cursor_key_retired",
        "relation_snapshot_changed"
      ]
    },
    {
      "method": "POST",
      "path": "/v1/coach-relations/{relationId}/revoke",
      "request": "RelationRevokeRequest",
      "success": 200,
      "response": "Relation",
      "errors": [
        "unauthorized",
        "relation_not_found",
        "relation_operation_conflict"
      ]
    },
    {
      "method": "GET",
      "path": "/v1/coach-relations/{relationId}/calendar?limit&cursor",
      "success": 200,
      "response": "CalendarProjectionPage",
      "errors": [
        "unauthorized",
        "relation_not_found",
        "invalid_cursor",
        "cursor_expired",
        "cursor_key_retired",
        "relation_snapshot_changed"
      ]
    },
    {
      "method": "GET",
      "path": "/v1/coach-relations/{relationId}/completed-workouts?limit&cursor",
      "success": 200,
      "response": "CompletedWorkoutProjectionPage",
      "errors": [
        "unauthorized",
        "relation_not_found",
        "invalid_cursor",
        "cursor_expired",
        "cursor_key_retired",
        "relation_snapshot_changed"
      ]
    },
    {
      "method": "POST",
      "path": "/v1/coach-relations/{relationId}/training-proposals",
      "request": "CoachProposalCreateRequest",
      "success": 201,
      "response": "ProposalResponse",
      "errors": [
        "unauthorized",
        "relation_not_found",
        "proposal_stale",
        "relation_operation_conflict"
      ]
    },
    {
      "method": "PUT",
      "path": "/v1/coach-relations/{relationId}/training-proposals/{proposalId}",
      "request": "CoachProposalReviseRequest",
      "success": 200,
      "response": "ProposalResponse",
      "errors": [
        "unauthorized",
        "relation_not_found",
        "proposal_stale",
        "relation_operation_conflict"
      ]
    },
    {
      "method": "POST",
      "path": "/v1/coach-relations/{relationId}/training-proposals/{proposalId}/revoke",
      "request": "CoachProposalRevokeRequest",
      "success": 200,
      "response": "DecisionResponse",
      "errors": [
        "unauthorized",
        "relation_not_found",
        "proposal_stale",
        "relation_operation_conflict"
      ]
    }
  ],
