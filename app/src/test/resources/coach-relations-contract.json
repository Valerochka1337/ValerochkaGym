  "projections": {
    "calendarAllowlist": [
      "calendarPlanId",
      "routineId",
      "startsAtMillis",
      "timeZoneId",
      "title",
      "exercises[].name",
      "exercises[].type",
      "exercises[].plannedSetCount"
    ],
    "completedWorkoutAllowlist": [
      "workoutId",
      "finishedAtMillis",
      "exercises[].exerciseId",
      "exercises[].name",
      "sets[].weightKg",
      "sets[].reps",
      "sets[].durationSec",
      "sets[].speedKmh",
      "sets[].inclinePct"
    ],
    "forbidden": [
      "rawRecord",
      "activeWorkout",
      "note",
      "cue",
      "profile",
      "health",
      "measurement",
      "credential",
      "ai"
    ],
    "sourceCompatibility": "Arrays preserve valid empty data and existing source bounds: up to 200 exercises, 1000 sets per exercise. Completed projection includes only isCompleted=true sets; actual* metric value (including explicit null) wins when member exists, otherwise legacy corresponding metric is used. Never fall back to planned targets. No truncation; a single item exceeding responseBytes returns 413 without partial item."
  },
  "relationAuthority": {
