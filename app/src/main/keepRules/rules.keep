# R8-правила проекта. AGP объединяет все файлы из src/main/keepRules.
#
# kotlinx-serialization: сериализаторы @Serializable DTO Google API (SheetsApi/CalendarApi)
# ищутся рефлексией по companion-полю — R8 без правил его выбрасывает.
# Набор правил — рекомендованный kotlinx.serialization (README, раздел Android/R8).

# Сериализаторы, объявленные в companion object.
-if @kotlinx.serialization.Serializable class **
-keepclassmembers class <1> {
    static <1>$Companion Companion;
}

# serializer() у companion-объектов сериализуемых классов.
-if @kotlinx.serialization.Serializable class ** {
    static **$Companion Companion;
}
-keepclassmembers class <2>$Companion {
    kotlinx.serialization.KSerializer serializer(...);
}

# INSTANCE.serializer() у сериализуемых object-ов.
-keepclassmembers @kotlinx.serialization.Serializable class ** {
    public static ** INSTANCE;
}
-if @kotlinx.serialization.Serializable class ** {
    public static ** INSTANCE;
}
-keepclassmembers class <1> {
    kotlinx.serialization.KSerializer serializer(...);
}

# Синтетический $serializer (генерируется плагином для @Serializable-классов).
-keep,includedescriptorclasses class com.valerochka1337.valerochkagym.**$$serializer { *; }
