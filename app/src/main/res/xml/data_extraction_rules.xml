<?xml version="1.0" encoding="utf-8"?><!--
    Бэкап и перенос включены почти целиком (API 31+). API key нейросети исключён: ключ Keystore
    привязан к устройству, поэтому после переноса его безопаснее ввести заново.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/ai_secrets.preferences_pb" />
        <exclude domain="file" path="datastore/openrouter_secrets.preferences_pb" />
        <exclude domain="file" path="datastore/weekly_schedule_operations.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/ai_secrets.preferences_pb" />
        <exclude domain="file" path="datastore/openrouter_secrets.preferences_pb" />
        <exclude domain="file" path="datastore/weekly_schedule_operations.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
