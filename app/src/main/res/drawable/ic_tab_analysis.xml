<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Стекло пробирки + пузырьки: наклон 35° вправо. Стенки = внешний контур минус внутренняя
         полость (evenOdd), два маленьких кружка внутри — пузырьки (заполнены, вращаются с пробиркой). -->
    <group
        android:pivotX="12"
        android:pivotY="12"
        android:rotation="35">
        <path
            android:fillColor="@android:color/white"
            android:fillType="evenOdd"
            android:pathData="M9,2.5 L15,2.5 L15,18 A3,3 0 0 1 9,18 Z M10,4 L14,4 L14,18 A2,2 0 0 1 10,18 Z M11.4,8 A0.6,0.6 0 1 0 12.6,8 A0.6,0.6 0 1 0 11.4,8 Z M12.35,10.4 A0.45,0.45 0 1 0 13.25,10.4 A0.45,0.45 0 1 0 12.35,10.4 Z" />
    </group>

    <!-- Жидкость: поверхность строго горизонтальна (гравитация), а форма обрезана по наклонённой
         полости. Внешняя группа наклоняет clip-path вместе с пробиркой, внутренняя (-35°) возвращает
         прямоугольник жидкости в мировые координаты, чтобы его верх остался ровным. -->
    <group
        android:pivotX="12"
        android:pivotY="12"
        android:rotation="35">
        <clip-path android:pathData="M10,4 L14,4 L14,18 A2,2 0 0 1 10,18 Z" />
        <group
            android:pivotX="12"
            android:pivotY="12"
            android:rotation="-35">
            <path
                android:fillColor="@android:color/white"
                android:pathData="M0,12.5 L24,12.5 L24,24 L0,24 Z" />
        </group>
    </group>
</vector>
